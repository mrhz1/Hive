# Base URL of the FastAPI service. Used only when VITE_API_PROXY_TARGET
# below is unset.
#
# Two ways round, and only one of them involves CORS:
#
#   1. Straight at the API (this variable). The page and the API are
#      different origins, so the API has to allow this dev server's
#      origin -- set CORS_ORIGINS on the backend to match (see
#      .env.example at the repo root). Fine against a local uvicorn.
#
#   2. Through the dev server (VITE_API_PROXY_TARGET). Same origin, so
#      the browser sends no preflight at all and CORS does not enter
#      into it. Same shape as a deployment, which serves both from one
#      origin via scripts/serve_frontend.py + API_PROXY_TARGET.
#
# Option 1 cannot work when anything authenticating sits in front of the
# API -- Knox, the Cloudera AI app gateway, an SSO proxy. A preflight
# carries no cookies by definition, so that proxy answers it itself,
# with its own login redirect or its own header list, and the browser
# reports a CORS failure the API never saw and cannot fix. If the error
# names a request header ("field remote-user is not allowed"), that
# answer did not come from this API: it allows every header asked for.
# Use option 2.
VITE_API_BASE_URL=http://localhost:8100

# Set this and the dev server forwards /api to it, and the app talks to
# the dev server instead of the API. One variable does both halves.
# VITE_API_PROXY_TARGET=https://hive-api.example.cloudera.site
# Set only if that host's certificate is signed by an internal CA that
# Node does not trust.
# VITE_API_PROXY_INSECURE=false

# Local stand-in for the platform-authenticated principal: the username
# sent as REMOTE-USER. On Cloudera AI the platform sets that header, so
# this is unset there and the app reads whoever the API says the caller is.
VITE_DEV_USERNAME=
