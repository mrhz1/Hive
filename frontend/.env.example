# Base URL of the FastAPI service.
#
# Two ways round, and only one of them involves CORS:
#
#   1. Straight at the API. The page and the API are different origins,
#      so the API has to allow this dev server's origin -- set
#      CORS_ORIGINS on the backend to match (see .env.example at the
#      repo root). Fine against a local uvicorn; it does not work when
#      anything authenticating sits in front of the API, because the
#      browser's preflight gets that proxy's login redirect instead of
#      the API's answer and reports it as a CORS failure.
#
#   2. Through the dev server. Set VITE_API_BASE_URL=/api and
#      VITE_API_PROXY_TARGET to the API, and vite forwards it. Same
#      origin, so no preflight, no CORS_ORIGINS, and the same shape as a
#      deployment (scripts/serve_frontend.py + API_PROXY_TARGET).
VITE_API_BASE_URL=http://localhost:8100

# Where the dev server forwards /api. Leave unset for option 1.
# VITE_API_PROXY_TARGET=https://hive-api.example.cloudera.site
# Set only if that host's certificate is signed by an internal CA that
# Node does not trust.
# VITE_API_PROXY_INSECURE=false

# Local stand-in for the platform-authenticated principal: the username
# sent as REMOTE-USER. On Cloudera AI the platform sets that header, so
# this is unset there and the app reads whoever the API says the caller is.
VITE_DEV_USERNAME=
