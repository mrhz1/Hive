# API URL, used when VITE_API_PROXY_TARGET is not set.
# The API must allow this origin (CORS_ORIGINS in the root .env.example).
VITE_API_BASE_URL=http://localhost:8100

# Or proxy /api through the dev server (same origin, no CORS needed).
# Use this if there's an auth proxy in front of the API.
# VITE_API_PROXY_TARGET=https://hive-api.example.cloudera.site
# Only if the API uses a certificate Node doesn't trust.
# VITE_API_PROXY_INSECURE=false

# Username sent as REMOTE-USER locally. Leave empty on Cloudera.
VITE_DEV_USERNAME=
