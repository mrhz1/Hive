# Copy to .env.local and adjust values. Variable NAMES must match Cloudera
# AI exactly -- only the values change between environments.
CDSW_APP_PORT=8100
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DB=default
HIVE_AUTH=NOSASL
# HIVE_AUTH=GSSAPI      # value used in production on Cloudera AI
HIVE_SERVICE=hive
HIVE_USER=hive

# Where uploaded documents land. Must be visible to BOTH the API
# Application and the de-identification Job.
FILE_STORAGE_DIR=storage/patient_files

# Where de-identified output finally lives, per format.
#
# The pipeline first writes into a `deidentified/` folder next to the
# original -- that is a staging area, not a destination. Submitting the
# application stamps the patient id on the redacted PDFs and moves every
# output here. Nothing reads from the staging folder.
#
# Relative paths are resolved against the repo, absolute ones used as
# given. On Cloudera AI these are usually a mounted volume, and they must
# be writable by the API Application and readable by whoever downloads.
DEID_PDF_DIR=storage/deidentified/pdf
DEID_DICOM_DIR=storage/deidentified/dicom
# Word output has no specified home; this is the default it gets.
DEID_WORD_DIR=storage/deidentified/word

# --- de-identification -------------------------------------------------
# inline  = run it in the API's own background task (local, low volume)
# cml_job = mark the row and start a Cloudera AI Job run (production)
DEID_BACKEND=inline

# The two OCR stage interpreters. Paddle and Presidio cannot share a
# virtualenv, so there are two -- see OCR/README.md. Defaults are
# OCR/.venv-ocr and OCR/.venv-nlp; set absolute paths on Cloudera AI.
# DEID_OCR_PYTHON=/home/cdsw/OCR/.venv-ocr/bin/python
# DEID_NLP_PYTHON=/home/cdsw/OCR/.venv-nlp/bin/python

# The local model store. Cloudera AI blocks github and huggingface, so
# every weight is copied to OCR/models and loaded by path -- nothing
# downloads at job time. See OCR/models/README.md. Set this only if the
# store lives somewhere else (a read-only mount is fine).
# DEID_MODELS_DIR=/home/cdsw/OCR/models
# Loading by path only. Leave it on everywhere except a machine with
# egress that is staging the models in the first place.
# DEID_OFFLINE=true

# Required when DEID_BACKEND=cml_job. The rest (CML_PROJECT_ID,
# CML_API_KEY, CML_API_URL) are derived from the CDSW_* vars the
# platform injects.
# CML_DEID_JOB_ID=

# --- logging -----------------------------------------------------------
# console = aligned key=value for a terminal; json = one object per line
# for anything that ingests logs. Unset picks by where stdout goes: a
# terminal gets console, a captured pipe gets json -- which is what
# Cloudera AI does, so production needs nothing set here.
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# How many reverse proxies sit in front of the app, so the caller's
# address can be read out of X-Forwarded-For rather than the last hop's.
# Cloudera AI terminates auth in front of the workload, hence 1. Set 0
# only if nothing is in front -- the count has to match the deployment,
# because everything left of the trusted hops is client-supplied.
# TRUSTED_PROXY_COUNT=1

# --- access trail ------------------------------------------------------
# Who read, downloaded or exported what, and who was refused. Written to
# Hive `access_logs` by a background thread: events are buffered and
# flushed in batches, because a Hive INSERT costs seconds and the cost is
# per statement rather than per row. Nobody waits on the trail to open a
# file; the trade is that a kill between flushes loses what was queued
# (those events are in the Application log regardless).
# ACCESS_LOG_ENABLED=true
# ACCESS_LOG_FLUSH_SECONDS=5
# ACCESS_LOG_MAX_BATCH=200
# ACCESS_LOG_MAX_QUEUED=10000

# --- access alerts (scripts/access_alerts.py, run as a CML Job) --------
# Where the threshold emails go. Without it the job reports and exits 1.
# ALERT_EMAIL_TO=security@example.org
# ALERT_WINDOW_MINUTES=60
# Tune against real traffic: an alert that cries wolf is worse than none.
# ALERT_DOWNLOAD_LIMIT=50        # identified downloads by one account
# ALERT_EXPORT_LIMIT=5           # exports carry many records each
# ALERT_DENIED_LIMIT=15          # repeated refusals look like probing
# ALERT_AUTH_FAILURE_LIMIT=10

# --- email -------------------------------------------------------------
# Notifications for background uploads: the user an application is
# assigned to is emailed when their documents finish moving into
# storage, and when the move fails.
#
# Leave SMTP_HOST unset and nothing is sent -- every send becomes a
# logged no-op, so local development needs no mail server.
#
# The Cloudera relay takes plain SMTP on 25 with no credentials, which
# is the default here. SMTP_STARTTLS / SMTP_USER / SMTP_PASSWORD exist
# for pointing a laptop at a real provider; production sets none of them.
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_FROM=hive-noreply@example.org
# SMTP_FROM_NAME=Hive
# SMTP_TIMEOUT=15
# SMTP_STARTTLS=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- dashboard (scripts/serve_frontend.py) -----------------------------
# FRONTEND_DIST=frontend/dist
# Set to the API's URL to serve dashboard and API from one origin, which
# removes the CORS configuration entirely. Build the frontend with
# VITE_API_BASE_URL=/api when you use this.
# API_PROXY_TARGET=
