# Copy to .env.local and change the values. Variable names must match
# Cloudera AI, only the values are different per environment.
CDSW_APP_PORT=8100
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DB=default
HIVE_AUTH=NOSASL
# HIVE_AUTH=GSSAPI      # value used in production on Cloudera AI
HIVE_SERVICE=hive
HIVE_USER=hive

# --- Impala ------------------------------------------------------------
# impala = reads go to Impala, writes to Hive (default)
# hive   = everything goes to Hive
# Writes always go to Hive because Impala can't write to ACID ORC tables.
# READ_ENGINE=impala
#
# Name of the Cloudera AI data connection for Impala. If unset, everything
# goes to Hive.
# CML_IMPALA_CONNECTION=
#
# Database for Impala queries (defaults to HIVE_DB).
# IMPALA_DB=
#
# Reuse connections between requests (saves the Kerberos handshake).
# IMPALA_POOL=true
# HIVE_POOL=true
# Replace a pooled connection after it's been idle this long.
# POOL_MAX_IDLE_SECONDS=300

# Uploaded documents. Must be shared by the API and the de-id Job.
FILE_STORAGE_DIR=storage/patient_files

# De-identified output per format (used by the Files library upload).
# Relative paths are resolved from the repo root.
DEID_PDF_DIR=storage/deidentified/pdf
DEID_DICOM_DIR=storage/deidentified/dicom
DEID_WORD_DIR=storage/deidentified/word

# Submitted documents from the upload flow, per patient:
#   storage/submitted/AA1234/original/...
#   storage/submitted/AA1234/de_identified/...
# (files from intake stay in DATA_DIR and are not moved on submit)
# SUBMITTED_DIR=storage/submitted

# --- intake ------------------------------------------------------------
# Folder where files are pushed. Files are de-identified when a run is
# started (Start button on the Intake page, or make intake-start).
INTAKE_DIR=storage/incoming_data

# Where done files go (must be on the same disk as INTAKE_DIR):
#   original/        the original, same path as in INTAKE_DIR
#   de_identified/   the redacted copy, under the patient code
#   failed/          redaction failed
#   needs_attention/ no code, unsupported format, conflict or duplicate
DATA_DIR=storage/data

# A file changed in the last N seconds is left for the next run
# (in case it's still being copied).
# INTAKE_SETTLE_SECONDS=20

# Number of files redacted at the same time. Limited by memory more than
# CPU (about 18-31 s per page).
#   workers = min(cores / cores_per_worker, RAM / RAM_per_worker)
# DEID_WORKERS=4

# CPU threads per worker (sets OCR_CPU_THREADS, OMP_NUM_THREADS and
# MKL_NUM_THREADS). OCR uses 8 by default.
# DEID_WORKER_CPU_THREADS=2

# Expected memory per worker in GB. Used to start fewer workers if there
# isn't enough free memory.
# DEID_WORKER_MEMORY_GB=6

# Files per pipeline run. Bigger runs are faster since models load once
# per run.
# DEID_CHUNK_DICOM=40
# DEID_CHUNK_DOCUMENTS=4

# A worker is shown as stopped if its heartbeat is older than this.
# INTAKE_HEARTBEAT_STALE_SECONDS=300

# How often the number of files left in INTAKE_DIR is counted during a run.
# INTAKE_STATUS_SECONDS=300

# A patient is created (code only, other fields empty) when a code's first
# file is de-identified. At the end of a run, wait this long for pending
# patients to be saved.
# INTAKE_PATIENT_WAIT_SECONDS=30

# Cloudera Job that runs scripts/intake_run.py (started by the Start button
# when DEID_BACKEND=cml_job).
# CML_INTAKE_JOB_ID=

# --- patient codes -----------------------------------------------------
# Patient codes come from the file path or name, they are not generated.
# Default: 2-4 letters then 3-4 digits (AA0001, AVDD1200), case-insensitive.
# Be careful widening it, a loose pattern can match folder names like
# REPORT or SCAN01.
# PATIENT_CODE_PATTERN=[A-Z]{2,4}[0-9]{3,4}
#
# Or list the exact formats allowed: a prefix and a number of digits, comma
# separated. When set it replaces PATIENT_CODE_PATTERN everywhere -- the
# intake only picks up these codes, a patient can only be created with one,
# and the De-Identifier page lists them. Example: AA0001 and BBCDE0001.
# PATIENT_CODE_FORMATS=AA:4,BBCDE:4

# Keep the original file after submission (next to the de-identified
# copy). If false, the original is deleted on submit. Originals are not
# purged automatically.
# DEID_KEEP_ORIGINAL=true

# --- de-identification -------------------------------------------------
# inline  = run in the API background task (local, low volume)
# cml_job = start a Cloudera AI Job run (production)
DEID_BACKEND=inline

# Python for each OCR stage (two venvs, see OCR/README.md).
# Defaults are OCR/.venv-ocr and OCR/.venv-nlp.
# DEID_OCR_PYTHON=/home/cdsw/OCR/.venv-ocr/bin/python
# DEID_NLP_PYTHON=/home/cdsw/OCR/.venv-nlp/bin/python

# Model folder (see OCR/models/README.md). Only set it if the models are
# somewhere other than OCR/models.
# DEID_MODELS_DIR=/home/cdsw/OCR/models
# Load models from disk only. Turn off only on a machine that is
# downloading the models.
# DEID_OFFLINE=true

# Timeout per file. At 19-31 s per page, 5400 s covers about 175 pages.
# Set it from your longest document.
# DEID_TIMEOUT_SECONDS=5400

# --- progress ----------------------------------------------------------
# Progress files are written to FILE_STORAGE_DIR/.progress/<id>.json.
# A progress file older than this is ignored (e.g. the Job was killed).
# DEID_PROGRESS_STALE_SECONDS=300
#
# Don't send the same "de-identification finished" email twice within
# this many seconds.
# DEID_NOTICE_REPEAT_SECONDS=120

# Required when DEID_BACKEND=cml_job. CML_PROJECT_ID, CML_API_KEY and
# CML_API_URL come from the CDSW_* variables.
# CML_DEID_JOB_ID=

# Documents per OCR process. Keep at 1 unless the Job has spare memory
# (exit -9 means out of memory).
# DEID_OCR_BATCH_SIZE=1

# How often the dispatcher checks the running Job (starts at POLL_SECONDS
# and backs off up to MAX_POLL_SECONDS).
# DEID_DISPATCH_POLL_SECONDS=10
# DEID_DISPATCH_MAX_POLL_SECONDS=60
# DEID_DISPATCH_POLL_BACKOFF=1.5
# How often to look for new queued files when idle.
# DEID_DISPATCH_IDLE_SECONDS=60

# --- CORS --------------------------------------------------------------
# Allowed origins (scheme + host + port, no trailing slash). If unset, the
# Vite dev server on localhost ports 5173-5180 is allowed. Not needed if
# the dashboard and API are served from the same origin (API_PROXY_TARGET).
# CORS_ORIGINS=https://dashboard.example.cloudera.site,http://localhost:5173

# --- logging -----------------------------------------------------------
# console or json. If unset: console in a terminal, json otherwise.
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# Number of reverse proxies in front of the app, used to read the client IP
# from X-Forwarded-For. 1 on Cloudera AI.
# TRUSTED_PROXY_COUNT=1

# --- access log --------------------------------------------------------
# Access events are buffered and written to Hive `access_logs` in batches.
# ACCESS_LOG_ENABLED=true
# ACCESS_LOG_FLUSH_SECONDS=5
# ACCESS_LOG_MAX_BATCH=200
# ACCESS_LOG_MAX_QUEUED=10000

# --- access alerts (scripts/access_alerts.py, run as a CML Job) --------
# Where alert emails go. If unset the job prints the report and exits 1.
# ALERT_EMAIL_TO=security@example.org
# ALERT_WINDOW_MINUTES=60
# ALERT_DOWNLOAD_LIMIT=50        # identified downloads by one account
# ALERT_EXPORT_LIMIT=5
# ALERT_DENIED_LIMIT=15
# ALERT_AUTH_FAILURE_LIMIT=10

# --- email -------------------------------------------------------------
# If SMTP_HOST is unset, emails are only logged. The Cloudera relay is
# plain SMTP on port 25 with no login.
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_FROM=hive-noreply@example.org
# SMTP_FROM_NAME=Hive

# Dashboard URL, used for links in emails. No trailing slash.
# APP_BASE_URL=https://patients.example.cloudera.site
# SMTP_TIMEOUT=15
# SMTP_STARTTLS=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- dashboard (scripts/serve_frontend.py) -----------------------------
# FRONTEND_DIST=frontend/dist
# Set to the API URL to serve the dashboard and API from one origin.
# Build the frontend with VITE_API_BASE_URL=/api in that case.
# API_PROXY_TARGET=
